{
  "plugin_id": "silo.watchprovider.floppy",
  "version": "0.1.0",
  "checksum": "__CHECKSUM__",
  "silo_api_version": "v1",
  "supported_platforms": [
    { "os": "darwin", "arch": "arm64" },
    { "os": "linux", "arch": "amd64" },
    { "os": "linux", "arch": "arm64" }
  ],
  "capabilities": [
    {
      "type": "watch_sync_provider.v1",
      "id": "floppy",
      "display_name": "Floppy",
      "description": "Bidirectional watch history, resume progress, and live scrobbling for a self-hosted Floppy instance.",
      "watch_sync_provider": {
        "auth_methods": ["WATCH_SYNC_AUTH_METHOD_API_KEY"],
        "export_watched": true,
        "import_watched": true,
        "import_progress": true,
        "supported_media_types": [
          "WATCH_SYNC_MEDIA_TYPE_MOVIE",
          "WATCH_SYNC_MEDIA_TYPE_EPISODE"
        ],
        "external_id_namespaces": ["tmdb", "imdb", "tvdb"],
        "max_batch_size": 50,
        "scrobble_playback": true
      }
    }
  ],
  "global_config_schema": [
    {
      "key": "floppy",
      "title": "Floppy instance",
      "description": "Connection details for the self-hosted Floppy server.",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"base_url\":{\"type\":\"string\",\"format\":\"uri\"}},\"required\":[\"base_url\"],\"additionalProperties\":false}",
      "required": true,
      "admin_form": {
        "submit_label": "Save Floppy instance",
        "fields": [
          {
            "key": "base_url",
            "label": "Base URL",
            "description": "Root URL of the Floppy instance. API paths are added automatically.",
            "control": "ADMIN_FORM_CONTROL_TEXT",
            "placeholder": "https://floppy.example.com",
            "required": true
          }
        ]
      }
    }
  ],
  "category": "Watch Providers",
  "presentation": {
    "display_name": "Floppy Watch Provider",
    "summary": "Sync Silo watch activity with a self-hosted Floppy instance.",
    "description_markdown": "Imports movie and episode history and resume progress, exports completed watches, and forwards live playback start, pause, and stop events.",
    "setup_markdown": "Configure the Floppy instance URL, then connect each Silo profile with a Floppy API token.",
    "homepage_url": "https://github.com/dannyvfilms/Floppy",
    "source_url": "https://github.com/Silo-Server/silo-plugin-watchprovider-floppy",
    "support_url": "https://github.com/Silo-Server/silo-plugin-watchprovider-floppy/issues",
    "changelog_url": "https://github.com/Silo-Server/silo-plugin-watchprovider-floppy/releases",
    "publisher_name": "Silo Server",
    "publisher_url": "https://github.com/Silo-Server",
    "license_spdx": "AGPL-3.0-only"
  }
}
